{
  "name": "mcp-bw-adt-api",
  "version": "0.2.0",
  "description": "MCP server exposing SAP BW/4HANA ADT (bw-adt-api) operations to LLM clients, with local-file buffering for large XML payloads and table data.",
  "type": "commonjs",
  "main": "build/index.js",
  "bin": {
    "mcp-bw-adt-api": "build/index.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "start": "node build/index.js",
    "list-tools": "node build/index.js --list-tools"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "SAP",
    "BW",
    "BW4HANA",
    "ADT",
    "Business Warehouse"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lingcSun/mcp-bw-adt-api.git"
  },
  "files": [
    "build",
    "README.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "bw-adt-api": "^0.2.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.9.3"
  }
}
