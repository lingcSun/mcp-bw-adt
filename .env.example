# ─── Multi-environment (recommended) ───────────────────────────────────────
# Comma-separated profile names. Each profile uses BW_<NAME>_* variables below.
BW_PROFILES=test,prod
# Active profile at startup (must be listed in BW_PROFILES). Defaults to the first.
BW_DEFAULT=test

# Test — writable
BW_TEST_BASE_URL=http://your-bw-test:8000
BW_TEST_USERNAME=your-username
BW_TEST_PASSWORD=your-password
BW_TEST_CLIENT=100
BW_TEST_LANGUAGE=ZH
BW_TEST_READONLY=false
# BW_TEST_ALLOW_UNAUTHORIZED=false

# Prod — read-only (mutating tools are rejected by the MCP server)
BW_PROD_BASE_URL=http://your-bw-prod:8000
BW_PROD_USERNAME=your-username
BW_PROD_PASSWORD=your-password
BW_PROD_CLIENT=100
BW_PROD_LANGUAGE=ZH
BW_PROD_READONLY=true
# BW_PROD_ALLOW_UNAUTHORIZED=false

# ─── Legacy single environment (still supported) ─────────────────────────────
# If BW_PROFILES is unset, these map to a profile named "default".
# BW_BASE_URL=http://your-bw-server:8000
# BW_USERNAME=your-username
# BW_PASSWORD=your-password
# BW_CLIENT=100
# BW_LANGUAGE=EN
# BW_READONLY=false
# BW_ALLOW_UNAUTHORIZED=false

# Root directory for the local-file buffering feature (optional).
# Large XML payloads and table data are read from / written under this directory.
# Defaults to <cwd>/.mcp-bw-out (a scratch folder) to avoid overwriting project files.
# Set this to the workspace root (or another folder) if you prefer paths relative to that.
BW_MCP_WORKDIR=
